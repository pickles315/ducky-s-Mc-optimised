{
  "schemaVersion": 1,
  "id": "ducky_optimised",
  "version": "${version}",
  "name": "Ducky's MC Optimised",
  "description": "A client-side performance add-on for Minecraft 26.2 with configurable entity and block entity culling.",
  "authors": ["Ducky"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["dev.ducky.optimised.DuckyOptimised"]
  },
  "mixins": [
    {
      "config": "ducky_optimised.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*",
    "yet_another_config_lib_v3": ">=3.9.7"
  }
}
